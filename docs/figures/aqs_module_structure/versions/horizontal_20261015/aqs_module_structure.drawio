        <mxCell id="sum" value="&lt;div style=&quot;font-size:32px;font-weight:700;color:#151515;line-height:1.5&quot;&gt;+&lt;/div&gt;" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#505050;strokeWidth=2;fontFamily=Times New Roman;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1590" y="530" width="50" height="50" />
