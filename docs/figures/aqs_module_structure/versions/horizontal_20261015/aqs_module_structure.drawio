        <mxCell id="output" value="&lt;div style=&quot;font-size:27px;font-weight:700;color:#151515;line-height:1.5&quot;&gt;Q2′&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:400;color:#151515;line-height:1.5&quot;&gt;300 x 256&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#F7D3CE;strokeColor=#505050;strokeWidth=2;fontFamily=Times New Roman;spacing=8;" vertex="1" parent="1">
