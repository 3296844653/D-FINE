  <diagram id="AQS-L2-internal-structure" name="AQS-L2 internal structure">
    <mxGraphModel dx="1980" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;font-size:31px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;AQS-L2：自适应query门控与上下文残差增强&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="35" width="1750" height="50" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;font-size:19px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;展示普通检测query的计算；与当前 AdaptiveQuerySelectionRefiner 实现一致&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="94" width="1750" height="38" />
        </mxCell>
        <mxCell id="scores" value="&lt;div style=&quot;font-size:21px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;L2类别logits S₂&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;ClsHead₂ + LQE₂&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;300 × 3&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EDF4FA;strokeColor=#4274A7;strokeWidth=2;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="175" width="200" height="125" />
        </mxCell>
        <mxCell id="importance" value="&lt;div style=&quot;font-size:22px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;置信度重要性&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;sᵢ = max_c sigmoid(Sᵢc)&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EDF4FA;strokeColor=#4274A7;strokeWidth=2;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="315" y="175" width="205" height="125" />
        </mxCell>
        <mxCell id="gate" value="&lt;div style=&quot;font-size:24px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;硬门控 + STE&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;g_h = 1[sᵢ ≥ τ]&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;g_s = sigmoid((sᵢ − τ)/T)&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;前向：硬选择；反向：软梯度&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;T = 0.10（固定）&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFF1E3;strokeColor=#B85A1D;strokeWidth=2;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="570" y="165" width="255" height="195" />
        </mxCell>
        <mxCell id="threshold" value="&lt;div style=&quot;font-size:22px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;可学习阈值 τ&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;τ = sigmoid(θ)&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;τ₀ = 0.50&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFF1E3;strokeColor=#B85A1D;strokeWidth=2;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="315" y="365" width="220" height="110" />
        </mxCell>
        <mxCell id="query" value="&lt;div style=&quot;font-size:23px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;L2 query Q₂&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;300 × 256&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;保留全部query&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EDF4FA;strokeColor=#4274A7;strokeWidth=2;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="635" width="185" height="115" />
        </mxCell>
        <mxCell id="norm" value="&lt;div style=&quot;font-size:22px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;LayerNorm&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;LN(qᵢ)&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EDF4FA;strokeColor=#4274A7;strokeWidth=2;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="300" y="635" width="165" height="115" />
        </mxCell>
        <mxCell id="pool" value="&lt;div style=&quot;font-size:23px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;选中query的上下文池化&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;c = Σᵢ gᵢqᵢ / max(Σᵢ gᵢ, 1)&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;将c广播至所有query位置&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFF1E3;strokeColor=#B85A1D;strokeWidth=2;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="855" y="390" width="430" height="155" />
        </mxCell>
        <mxCell id="concat" value="&lt;div style=&quot;font-size:23px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;拼接&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;[ LN(qᵢ) ; c ]&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;256 + 256 → 512&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EDF4FA;strokeColor=#4274A7;strokeWidth=2;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="855" y="635" width="205" height="115" />
        </mxCell>
        <mxCell id="mlp" value="&lt;div style=&quot;font-size:23px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;融合MLP&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;Linear → SiLU → Linear&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;512 → 256 → 256&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EDF4FA;strokeColor=#4274A7;strokeWidth=2;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1115" y="635" width="230" height="115" />
        </mxCell>
        <mxCell id="scale" value="&lt;div style=&quot;font-size:22px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;可学习残差缩放&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;β = tanh(ρ)&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;ρ₀ = 0.10&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFF1E3;strokeColor=#B85A1D;strokeWidth=2;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1410" y="420" width="210" height="115" />
        </mxCell>
        <mxCell id="multiply" value="&lt;div style=&quot;font-size:24px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;门控残差&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;β · gᵢ · Δqᵢ&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;Δqᵢ = MLP([LN(qᵢ); c])&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFF1E3;strokeColor=#B85A1D;strokeWidth=2;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1410" y="625" width="210" height="135" />
        </mxCell>
        <mxCell id="add" value="&lt;div style=&quot;font-size:35px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;+&lt;/div&gt;" style="ellipse;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#B85A1D;strokeWidth=2;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1680" y="660" width="65" height="65" />
        </mxCell>
        <mxCell id="out" value="&lt;div style=&quot;font-size:21px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;增强query Q₂′&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;300 × 256&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#FFF1E3;strokeColor=#B85A1D;strokeWidth=2;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1790" y="635" width="160" height="115" />
        </mxCell>
        <mxCell id="l3" value="&lt;div style=&quot;font-size:21px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;Decoder L3&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;继续分类与定位&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fillColor=#EDF4FA;strokeColor=#4274A7;strokeWidth=2;fontFamily=Arial;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1790" y="895" width="160" height="100" />
        </mxCell>
        <mxCell id="gate_label" value="&lt;div style=&quot;font-size:18px;font-weight:400;color:#B85A1D;line-height:1.5&quot;&gt;门控g：选择池化query，同时控制残差写入&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="900" y="220" width="620" height="30" />
        </mxCell>
        <mxCell id="ln_label" value="&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;每个query的归一化特征&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="650" width="320" height="32" />
        </mxCell>
        <mxCell id="skip_label" value="&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;恒等路径：gᵢ = 0时，原query保持不变；不是删除query&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="835" width="820" height="30" />
        </mxCell>
        <mxCell id="equation" value="&lt;div style=&quot;font-size:25px;font-weight:700;color:#23354B;line-height:1.5&quot;&gt;qᵢ′ = qᵢ + tanh(ρ) · gᵢ · MLP([LN(qᵢ); c])&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="906" width="1580" height="45" />
        </mxCell>
        <mxCell id="ste_note" value="&lt;div style=&quot;font-size:18px;font-weight:400;color:#52647A;line-height:1.5&quot;&gt;STE：g = stopgrad(g_h − g_s) + g_s；MLP最后一层零初始化，使初始残差为0。&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="962" width="1580" height="34" />
